# Database
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/lucknow_events
ALEMBIC_DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/lucknow_events

# Redis
REDIS_URL=redis://redis:6379/0

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app/data/snapshots
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lucknow-events

# Admin Auth
JWT_SECRET=change_me_to_a_random_32_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Source API keys
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=

# App
CORS_ORIGINS=http://localhost:3000
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
SERVICE_NAME=api
ENVIRONMENT=development

# Frontend logging
NEXT_PUBLIC_LOG_LEVEL=debug

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side (SSR/ISR/build) API base URL. In Docker dev, use http://api:8000/api/v1
INTERNAL_API_URL=
NEXT_PUBLIC_SITE_NAME=Lucknow Tech Events
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# =============================================================================
# Ingestion Engine V1 (backend/v1) — own prefix so it cannot read V0 settings
# =============================================================================
# Everything that describes the *instance* (tenant, models, prices, taxonomy) lives in
# backend/v1/config/instance.yaml, not here. These describe the *process*.
V1_ENVIRONMENT=development
V1_LOG_LEVEL=INFO
V1_LOG_FORMAT=console
# Optional: only needed when V1_LLM_BUDGET_LEDGER=postgres
V1_DATABASE_URL=
# Shared secret for the /llm and /config endpoints. REQUIRED outside development.
V1_ENGINE_TOKEN=
# memory | postgres. Must be postgres outside development (a cap that a restart clears
# is not a cap) — the app refuses to start otherwise.
V1_LLM_BUDGET_LEDGER=memory
# Override llm.default from instance.yaml without editing the file.
V1_LLM_DEFAULT_PROFILE=
# Set to 1 to allow /llm/complete and /llm/selftest to call PAID providers.
V1_LLM_ALLOW_LIVE=
# Provider keys referenced by instance.yaml `api_key_ref`. V1_-prefixed wins, then bare.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
