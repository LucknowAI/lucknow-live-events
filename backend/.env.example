# =============================================================================
# backend/.env  —  copy this file to `.env` and fill in what you need
# =============================================================================
#   cp backend/.env.example backend/.env
#
# `.env` is gitignored. This example file is not. Never put a real key in here.
#
# The V0 pipeline reads this same file with unprefixed names; the V1 engine uses
# the `V1_` prefix for its own process settings so the two can never read each
# other's configuration by accident.
#
# NOTHING BELOW IS REQUIRED TO RUN THE ENGINE.
# With an empty .env the engine boots, serves every read endpoint, and runs the
# entire free half of discovery against live sources. Keys only unlock the paid
# paths. Start with none and add them when you need them.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Process settings  (all optional — these are the defaults)
# -----------------------------------------------------------------------------

# development | staging | production
# `development` is permissive: missing API keys are warnings, the engine token is
# optional, in-memory ledgers are allowed. Anything else is strict and the app
# REFUSES TO START if a spend control is not durable. That refusal is the point.
V1_ENVIRONMENT=development

# console | json   (json is the GCP-shaped structured output)
V1_LOG_FORMAT=console
V1_LOG_LEVEL=INFO

# Where the instance config lives. Only change this to run a different instance.
# V1_CONFIG_PATH=v1/config/instance.yaml


# -----------------------------------------------------------------------------
# 2. Database  (optional in development, required outside it)
# -----------------------------------------------------------------------------
# Without it the engine runs fine — spend counters and discovered URLs just live
# in process memory and vanish on restart. Fine for trying things out; not fine
# for anything that runs on a schedule.
#
# Must be the ASYNC driver: postgresql+asyncpg://, not postgresql://
#
# ⚠️ The role in this URL MUST NOT be a superuser. Postgres exempts superusers
#    from row-level security even when it is forced, so a superuser here silently
#    turns the tenant-isolation policies into decoration.

# V1_DATABASE_URL=postgresql+asyncpg://appuser:password@localhost:5432/lucknow_events


# -----------------------------------------------------------------------------
# 3. Durable spend controls  (required when V1_ENVIRONMENT is not development)
# -----------------------------------------------------------------------------
# A cap a restart clears is not a cap. A SERP cache a restart clears has a 0% hit
# rate, because a discovery run is a short-lived process. The app checks all three
# at startup and names whichever one is wrong.

# V1_LLM_BUDGET_LEDGER=postgres
# V1_SEARCH_BUDGET_LEDGER=postgres
# V1_SEARCH_CACHE_BACKEND=postgres


# -----------------------------------------------------------------------------
# 4. Endpoint auth  (required when V1_ENVIRONMENT is not development)
# -----------------------------------------------------------------------------
# Sent as the `X-Engine-Token` header. The /llm/* and /discovery/* endpoints that
# spend money accept free-text input against our provider keys — unauthenticated,
# they are a funded anonymous relay. Generate one with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"

# V1_ENGINE_TOKEN=


# -----------------------------------------------------------------------------
# 5. Provider keys  (all optional)
# -----------------------------------------------------------------------------
# Resolved in this order:  $V1_<NAME>  →  $<NAME>  →  $V1_SECRETS_DIR/<NAME> file
# The file form is the Cloud Run / Kubernetes mount convention; use env vars locally.
#
# `GET /llm/profiles` and `GET /discovery/providers` report which of these is
# missing, by name, so you never have to guess which one is blocking you.

# --- LLM -------------------------------------------------------------------
# Default profile is gemini_flash_lite, so this is the one that unlocks the most.
# V1_GEMINI_API_KEY=

# Used by classification, dedup tie-breaks and URL triage.
# V1_GROQ_API_KEY=

# Optional. One key, many models.
# V1_OPENROUTER_API_KEY=

# --- Web search ------------------------------------------------------------
# Primary. 2,500 free credits, ONE TIME per account — they do not renew, so do
# not point a test loop at this.
# V1_SERPER_API_KEY=

# Secondary. NOTE THE FORMAT: this is "login:password", not a token.
# V1_DATAFORSEO_CREDENTIALS=

# Tertiary. 1,000 credits/month, recurring.
# V1_TAVILY_API_KEY=


# -----------------------------------------------------------------------------
# 6. Spend opt-in  (deliberately separate from the keys)
# -----------------------------------------------------------------------------
# A key being present is NOT consent to spend it. Keys end up in a shared .env
# and a discovery run issues hundreds of queries with nobody watching, so real
# spending needs a second, explicit switch. Leave both unset for normal work.

# V1_LLM_ALLOW_LIVE=1
# V1_SEARCH_ALLOW_LIVE=1


# -----------------------------------------------------------------------------
# 7. Per-run overrides  (handy, not persistent — prefer setting these inline)
# -----------------------------------------------------------------------------
# Route EVERY model call to one profile (also clears the per-task routing, which
# a plain default override would leave pinned to a paid provider):
#   V1_LLM_FORCE_PROFILE=local_lmstudio uvicorn v1.api.app:app --port 8100
#
# Collapse the search chain to one provider — the way to run discovery entirely
# on recorded fixtures with no network:
#   V1_SEARCH_FORCE_PROVIDER=ci_fixture uvicorn v1.api.app:app --port 8100
